# --- BUILD DIRECTORIES ---
# Files generated by Gradle and the build process (temporary files and caches)
.gradle
.kotlin/
/build
/captures
/app/release
.externalNativeBuild
.cxx

# --- LOCAL CONFIGURATION & SECRETS ---
# local.properties contains the path to the Android SDK on your machine
/local.properties
local.properties

# Sensitive configuration files (API keys, Google services, secrets)
google-services.json
secrets.xml

# --- APP SIGNING (CRITICAL) ---
# Signing keys (.jks, .keystore): must NEVER be committed, for security reasons
*.jks
*.keystore
*.p12

# --- IDE CONFIGURATION ---
# Settings specific to Android Studio / IntelliJ / AI Agent (may vary from one developer to another)
*.iml
*.ipr
*.iws
.idea/
.artifacts/

# --- OPERATING SYSTEM ---
# Temporary files created by macOS
.DS_Store

# --- FASTLANE ---
# Reports, logs and screenshots generated automatically during deployment automation
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
