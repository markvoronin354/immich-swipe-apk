<?xml version="1.0" encoding="utf-8"?>
<!--
    Used on Android 11 and older. The app opts out of backup (allowBackup=false), and this file makes
    that explicit: nothing is included. Saved API keys are encrypted with a device-bound Keystore key,
    so a restored copy could not be read anyway.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
